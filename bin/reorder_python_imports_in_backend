#!/usr/bin/env bash

function error_handler() {
  >&2 echo "Exited with BAD EXIT CODE '${2}' in ${0} script at line: ${1}."
  exit "$2"
}
trap 'error_handler ${LINENO} $?' ERR
set -o errtrace -o errexit -o nounset -o pipefail

# Match import sorting in the Ruff pre-commit hook.
uv run ruff check --select I --fix --exclude load_database_models.py spiffworkflow-backend/src
