<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_natural_language_time_range" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_natural_language_time_range" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_to_resolver</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_to_resolver" sourceRef="StartEvent_1" targetRef="resolve_time_range" />
    <bpmn:scriptTask id="resolve_time_range" name="Resolve time range">
      <bpmn:incoming>Flow_to_resolver</bpmn:incoming>
      <bpmn:outgoing>Flow_to_end</bpmn:outgoing>
      <bpmn:script><![CDATA[# Stub resolver: the real parser lives in the deployment's extension process
# model. This fixture only verifies the extension endpoint plumbing.
result = {
    "status": "valid",
    "value": {
        "expression": expression,
        "start": "2026-08-30T16:00:00Z",
        "end": "2026-08-30T17:00:00Z",
        "time_zone": time_zone,
    },
    "assumptions": ["stub"],
}
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_to_end" sourceRef="resolve_time_range" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
